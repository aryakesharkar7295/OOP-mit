#include<iostream>
using namespace std;
class employee
{
public:
       string name;
       int id;
       float salary;

       void input()
       {
          cout<<"Enter Employee Name:"<<"\n";
          cin>>name;

          cout<<"Enter Employee ID:"<<"\n";
          cin>>id;

          cout<<"Enter Employee Salary:"<<"\n";
          cin>>salary;
        }

        void display()
        {
          cout<<"-----Employee Details-----"<<"\n";

         cout<<"Employee Name:"<<name<<"\n";
         cout<<"ID:"<<id<<"\n";
         cout<<"Salary:"<<salary<<"\n";
        }
};

int main()
{
     employee e1;
     e1.input();
     e1.display();
     return 0;
}
